{
  "//": "Ocdup 项目配置示例。复制为 ocd.json 放在项目根（或用 OCD_CONFIG 指向本文件）。",
  "//paths": "interface_cfg / target_cfg 是 OpenOCD scripts 目录下的脚本名（由 openocd -s 解析）；其余相对路径以本文件所在目录为基准。",
  "//interface": "interface_cfg 建议用 \"auto\"：连接时自动识别已插探针（AT-Link / CMSIS-DAP / ST-Link / J-Link）并选对应脚本；也可显式指定。",
  "interface_cfg": "auto",
  "target_cfg": "target/at32f403axx.cfg",
  "transport": "swd",
  "host": "127.0.0.1",
  "port": 6666,
  "command_timeout_seconds": 60,
  "permissions": {
    "read_only": false,
    "allow_memory_write": true,
    "allow_flash": true,
    "allow_flash_erase": false,
    "allow_exec": true,
    "allow_raw_command": true,
    "flash_allowed_paths": ["build/"],
    "flash_max_bytes": 1048576,
    "memory_read_max_bytes": 4096,
    "dump_allowed_paths": ["dumps/"],
    "dump_max_bytes": 67108864
  }
}
