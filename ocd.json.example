{
  "//": "Ocdup 项目配置示例。复制为 ocd.json 放在项目根（或用 OCD_CONFIG 指向本文件）。",
  "//paths": "interface_cfg / target_cfg 是 OpenOCD scripts 目录下的脚本名（由 openocd -s 解析）；其余相对路径以本文件所在目录为基准。",
  "//interface": "interface_cfg 建议用 \"auto\"：连接时自动识别已插探针（AT-Link / CMSIS-DAP / ST-Link / J-Link）并选对应脚本；也可显式指定。",
  "//elf_path": "符号层 L1 的默认镜像（未 strip 的 .elf，相对路径以本文件目录为基准）：list/read/write_variable 用；也可每次传 file 参数。",
  "//svd_path": "符号层 L2（v0.4.21）的默认 SVD（CMSIS-SVD XML，厂商 SDK 或 keil.pack 里都有）：read/write_peripheral_register 免传 file；也可 load_svd(file=...) 每会话加载。",
  "//chip_id_map": "identify_chip 用：DEV_ID（hex，如 \"0x410\"）-> 家族/建议 target_cfg 的映射；省略 = 只报原始值。DEV_ID 见各厂商参考手册的 DBGMCU 章节。",
  "//target_presets": "target 注册表（v0.4.0）：家族名 -> openocd target（值就是 -f 的参数：scripts 名或绝对路径均可）。identify 认出的家族与当前 target_cfg 不符时回报失配行，set_target <家族名> 一键切换并重启后端（外部实例占端口时只会换配置并警告）；'list' 看清单。加芯片 = 这里 + chip_id_map 各一行，零编译。仓库自带的板级 cfg 见 cfgs/（手写 cfg 建议写绝对路径）。",
  "interface_cfg": "auto",
  "target_cfg": "target/at32f403axx.cfg",
  "transport": "swd",
  "host": "127.0.0.1",
  "port": 6666,
  "command_timeout_seconds": 60,
  "chip_id_map": {
    "0x410": "STM32F103"
  },
  "target_presets": {
    "AT32F403A": "target/at32f403axx.cfg",
    "STM32F103": "target/stm32f1x.cfg"
  },
  "//raw_command": "allow_raw_command 默认 false：run_command 是 opt-in 逃生舱；开启后写类命令仍有内容分类（与专用工具同权或重定向专用工具）。注意：含 [..] 命令替换的段一律 BLOCKED（v0.4.35：替换先于头命令求值，静态分类拦不住），本开关不是白名单的旁路。",
  "permissions": {
    "read_only": false,
    "allow_memory_write": true,
    "allow_flash": true,
    "allow_flash_erase": false,
    "allow_exec": true,
    "allow_raw_command": true,
    "allow_set_permissions": false,
    "flash_allowed_paths": ["build/"],
    "flash_max_bytes": 1048576,
    "memory_read_max_bytes": 4096,
    "dump_allowed_paths": ["dumps/"],
    "dump_max_bytes": 67108864
  }
}
